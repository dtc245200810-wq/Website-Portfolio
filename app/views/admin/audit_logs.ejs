<%- include('admin_header') %>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-clipboard-list highlight"></i> Lịch Sử Kiểm Toán Hệ Thống (Audit Logs)</h3>
        <div class="filter-group">
            <a href="/admin/audit" class="btn btn-sm <%= !filterAction ? 'btn-primary' : 'btn-outline' %>">Tất cả</a>
            <a href="/admin/audit?action=LOGIN_SUCCESS" class="btn btn-sm <%= filterAction === 'LOGIN_SUCCESS' ? 'btn-primary' : 'btn-outline' %>">Đăng nhập thành công</a>
            <a href="/admin/audit?action=LOGIN_FAILED" class="btn btn-sm <%= filterAction === 'LOGIN_FAILED' ? 'btn-primary' : 'btn-outline' %>">Đăng nhập thất bại</a>
            <a href="/admin/audit?action=CREATE_PROJECT" class="btn btn-sm <%= filterAction === 'CREATE_PROJECT' ? 'btn-primary' : 'btn-outline' %>">Thêm dự án</a>
            <a href="/admin/audit?action=DELETE_PROJECT" class="btn btn-sm <%= filterAction === 'DELETE_PROJECT' ? 'btn-primary' : 'btn-outline' %>">Xóa dự án</a>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Thời Điểm</th>
                        <th>Tài Khoản</th>
                        <th>Hành Động</th>
                        <th>Thực Thể</th>
                        <th>Chi Tiết</th>
                        <th>Địa Chỉ IP</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                        <tr><td colspan="7" class="text-center text-muted p-4">Không có bản ghi nhật ký phù hợp.</td></tr>
                    <% } else { %>
                        <% logs.forEach(l => { %>
                            <tr>
                                <td><%= l.id %></td>
                                <td><small class="text-muted"><%= new Date(l.created_at).toLocaleString('vi-VN') %></small></td>
                                <td><span class="user-pill"><i class="fas fa-user"></i> <%= l.username %></span></td>
                                <td>
                                    <% if (l.action.includes('SUCCESS') || l.action.includes('CREATE')) { %>
                                        <span class="badge badge-success"><%= l.action %></span>
                                    <% } else if (l.action.includes('FAILED')) { %>
                                        <span class="badge badge-danger"><%= l.action %></span>
                                    <% } else if (l.action.includes('DELETE')) { %>
                                        <span class="badge badge-warning"><%= l.action %></span>
                                    <% } else { %>
                                        <span class="badge badge-info"><%= l.action %></span>
                                    <% } %>
                                </td>
                                <td><code><%= l.entity_type %> <%= l.entity_id ? '#' + l.entity_id : '' %></code></td>
                                <td><%= l.details %></td>
                                <td><code><%= l.ip_address %></code></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('admin_footer') %>
