<%- include('admin_header') %>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-inbox highlight"></i> Quản Lý Hộp Thư Liên Hệ</h3>
    </div>

    <% if (message) { %>
        <div class="alert alert-success m-3">
            <i class="fas fa-check-circle"></i> <%= message %>
        </div>
    <% } %>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Thời Gian</th>
                        <th>Người Gửi</th>
                        <th>Tiêu Đề</th>
                        <th>Nội Dung Tin Nhắn</th>
                        <th>Địa Chỉ IP</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (contacts.length === 0) { %>
                        <tr><td colspan="7" class="text-center text-muted p-4">Chưa có tin nhắn liên hệ nào.</td></tr>
                    <% } else { %>
                        <% contacts.forEach(c => { %>
                            <tr class="<%= c.is_read ? '' : 'table-row-unread' %>">
                                <td><small><%= new Date(c.created_at).toLocaleString('vi-VN') %></small></td>
                                <td>
                                    <strong><%= c.sender_name %></strong><br>
                                    <a href="mailto:<%= c.sender_email %>" class="text-link"><%= c.sender_email %></a>
                                </td>
                                <td><strong><%= c.subject %></strong></td>
                                <td><p class="message-preview"><%= c.message %></p></td>
                                <td><code><%= c.ip_address %></code></td>
                                <td>
                                    <% if (c.is_read) { %>
                                        <span class="badge badge-secondary"><i class="fas fa-check-double"></i> Đã đọc</span>
                                    <% } else { %>
                                        <span class="badge badge-danger"><i class="fas fa-envelope"></i> Mới</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="action-btn-group">
                                        <form action="/admin/contacts/<%= c.id %>/toggle-read" method="POST" style="display:inline;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn-action edit" title="Đánh dấu đã đọc/chưa đọc">
                                                <i class="fas <%= c.is_read ? 'fa-envelope' : 'fa-envelope-open' %>"></i>
                                            </button>
                                        </form>
                                        <form action="/admin/contacts/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa tin nhắn này?');" style="display:inline;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn-action delete" title="Xóa tin nhắn"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('admin_footer') %>
