<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <div class="login-icon"><i class="fas fa-user-shield"></i></div>
                <h2>Cổng Quản Trị Hệ Thống</h2>
                <p>Website Portfolio Cá Nhân - Đề 13</p>
                <div class="login-student-badge">Sinh viên: Tô Vũ Đạt &bull; DTC245200810</div>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fas fa-circle-exclamation"></i> <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST" class="login-form">
                <!-- CSRF Token Protection -->
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="redirect" value="<%= redirect %>">

                <div class="form-group">
                    <label for="username"><i class="fas fa-user"></i> Tên Đăng Nhập</label>
                    <input type="text" id="username" name="username" class="form-control" placeholder="Nhập tên tài khoản (admin)" required autofocus>
                </div>

                <div class="form-group">
                    <label for="password"><i class="fas fa-lock"></i> Mật Khẩu Quản Trị</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Nhập mật khẩu an toàn" required>
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-right-to-bracket"></i> Đăng Nhập Hệ Thống
                </button>
            </form>

            <div class="login-footer">
                <a href="/"><i class="fas fa-arrow-left"></i> Quay lại trang chủ Portfolio</a>
                <span class="divider">&bull;</span>
                <span class="security-note"><i class="fas fa-lock"></i> Xác thực bảo mật Bcrypt</span>
            </div>
        </div>
    </div>
</body>
</html>
