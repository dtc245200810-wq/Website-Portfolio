<%- include('admin_header') %>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-laptop-code highlight"></i> Danh Sách Dự Án Portfolio</h3>
        <a href="/admin/projects/new" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm Dự Án Mới</a>
    </div>

    <% if (message) { %>
        <div class="alert alert-success m-3">
            <i class="fas fa-check-circle"></i> <%= message %>
        </div>
    <% } %>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Hình Ảnh</th>
                        <th>Tên Dự Án</th>
                        <th>Danh Mục</th>
                        <th>Công Nghệ</th>
                        <th>Nổi Bật</th>
                        <th>Thứ Tự</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% projects.forEach(p => { %>
                        <tr>
                            <td><%= p.id %></td>
                            <td>
                                <img src="<%= p.image_url %>" alt="<%= p.title %>" class="table-thumb" onerror="this.src='/images/project-default.jpg'">
                            </td>
                            <td>
                                <strong><%= p.title %></strong><br>
                                <small class="text-muted">Slug: /project/<%= p.slug %></small>
                            </td>
                            <td><span class="badge badge-secondary"><%= p.category %></span></td>
                            <td><small><%= p.technologies %></small></td>
                            <td>
                                <% if (p.featured) { %>
                                    <span class="badge badge-success"><i class="fas fa-check"></i> Có</span>
                                <% } else { %>
                                    <span class="badge badge-dark">Không</span>
                                <% } %>
                            </td>
                            <td><%= p.sort_order %></td>
                            <td>
                                <div class="action-btn-group">
                                    <a href="/project/<%= p.slug %>" target="_blank" class="btn-action view" title="Xem trên website"><i class="fas fa-eye"></i></a>
                                    <a href="/admin/projects/<%= p.id %>/edit" class="btn-action edit" title="Chỉnh sửa"><i class="fas fa-pen"></i></a>
                                    <form action="/admin/projects/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dự án này?');" style="display:inline;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn-action delete" title="Xóa"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('admin_footer') %>
