# ========================================================
# PORTFOLIO SYSTEM CONFIGURATION ENVIRONMENT TEMPLATE
# ========================================================

NODE_ENV=production
PORT=3000
SESSION_SECRET=change_this_to_a_secure_random_string_32_chars_min

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password_secure
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_app
MYSQL_PASSWORD=change_this_portfolio_app_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MySQL Monitoring Exporter Credentials
MYSQL_EXPORTER_USER=mysqld_exporter
MYSQL_EXPORTER_PASSWORD=change_this_exporter_password

# phpMyAdmin Configuration
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=portfolio_app
PMA_PASSWORD=change_this_portfolio_app_password

# Admin Initial Account (seeded if not existing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_EMAIL=dtc245200810@ictu.edu.vn
ADMIN_FULL_NAME=To Vu Dat

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_this_grafana_password

# Host Ports
HOST_HTTP_PORT=8080
HOST_HTTPS_PORT=8443
HOST_PHPMYADMIN_PORT=8081
HOST_PROMETHEUS_PORT=9090
HOST_GRAFANA_PORT=3002
